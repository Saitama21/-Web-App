{
  "name": "hochu-wishlist-webapp",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check public/app.js",
    "test:parser": "node --test tests/makeup-image-parser.test.mjs",
    "test:price": "node --test tests/price-history.test.mjs tests/price-validator.test.mjs",
    "test:image": "node --test tests/generic-image-ranking.test.mjs",
    "test": "node --test tests/product-inspector.test.mjs tests/generic-image-ranking.test.mjs tests/current-price.test.mjs tests/touch-live-price.integration.test.mjs tests/avatar-validation.test.mjs tests/price-history.test.mjs tests/price-validator.test.mjs",
    "test:current-price": "node --test tests/current-price.test.mjs",
    "test:avatar": "node --test tests/avatar-validation.test.mjs",
    "test:inspector": "node --test tests/product-inspector.test.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
